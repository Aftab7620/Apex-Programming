public class ExceptionTaskException extends Exception {

  //Basic Try-Catch Block Handle Divide By Zero
  public static void divideByZeroExp(){
        integer num1=10;
        integer num2=0;
        try{
            double res=num1/num2;
        }catch(Exception e){
            System.debug(e);
        }
    }

  //Custom Exception

  public static void customExp(){
        try{
            integer age=14;
            if(age<18){
                throw new ExceptionTaskException('You Are Minor');
            }
        }catch(Exception e){
            system.debug(e.getMessage());
        }
       
    }

  //DML Exception Handlin

  public static void DmlExp(){
        try{
            Contact con=new Contact();
            con.phone='23456789';
            insert con;
        }catch(DMLException e){
            system.debug(e.getMessage());
        }
    }


  //Multiple Catch Blocks
  public static void multipleCatch(){
        integer i=19;
        integer j=0;
        try{
            double result=i/j;
            Account acc=new Account();
            acc.Description='hello';
            insert acc;
        }catch(MathException me){
            system.debug('exp occured:'+me.getMessage());
        }catch(DMLException e){
            system.debug(e.getMessage());
        }
    }

  //Exception in Trigger
  public static void triggerTryCatchEx(list<Account> newlist){
        list<contact> conlist=new list<contact>();
        for(Account acc:newlist){
            if(acc.Type=='Customer - Direct'){
                try{
                    Contact con=new Contact();
                    con.LastName=null;
                    con.Description='demo data';
                    con.AccountId=acc.id;
                    conlist.add(con);
                }catch(DMLException e){
                    system.debug(e.getMessage());
                }
            }
        }
        if(conlist.size()>0){
            try{
                insert conlist;
            }catch(Exception ex){
                system.debug(ex.getMessage());
            }
            
        }
    }
}
