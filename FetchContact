public class FetchContact{

  //Fetch Contact Associated with pass AccountId
   public static list<contact> getContactAssoAccount(id accid){
        list<contact> conlist=[select id,lastname,AccountId from Contact where AccountId =:accid];
        return conlist;
        
    }

  //Fetch All Contact Associated With Account
  public static list<contact> getAssoAccount(){
        list<contact> conlist=[select id,lastname from contact where accountid != null];
        return conlist;
    }
}
