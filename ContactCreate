public class ContactCreate{

  public static void createContact(string Lname,String Fname){
        contact con=new contact();
        con.lastname=Lname;
        con.FirstName=Fname;
        insert con;
    }

//Create Contact With Associated Account
   public static void createConAssoAccount(string lname,id accid){
        contact con=new contact();
        con.LastName=lname;
        con.AccountId=accid;
        insert con;
    }

  //Create Contact With No Of Count
  public static void createConCount(string lname,integer count){
        list<contact> conlist=new list<contact>();
        for(integer i=1;i<=count;i++){
            contact con=new contact();
            con.LastName=lname+i;
            conlist.add(con);
        }
        insert conlist;
    }
}
