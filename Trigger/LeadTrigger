trigger leadTrigger on Lead (before insert,after insert,before update,after update,after delete,before delete,after undelete) {
    //
    if(trigger.isBefore){
        if(trigger.isInsert){
            leadTriggerHandler.markRating(trigger.new);
        }
    }
    
    if(trigger.isAfter){
        if(trigger.isInsert){
            leadTriggerHandler.convertLead(trigger.new);

        }
    }

}
