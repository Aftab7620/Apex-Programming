public static ContactTriggerHandler{

 public static void checkName(list<contact> newlist){
        for(Contact con:newlist){
            if(con.lastname=='test'){
                con.addError('Last Name Cannot be Test');
            }
        }
    }

  public static void checkPhone(list<contact> newlist){
        for(Contact con:newlist){
            if(con.Phone == null){
                con.addError('Phone Cannot Be Null');
            }
        }
    }

 public static void checkEmail(list<contact> newlist){
        set<string> emailset=new set<string>();
        for(contact con:newlist){
            if(con.Email!=null){
                emailset.add(con.email);
            }
        }
        
        set<string>duplicate=new set<string>();
        list<contact> conlist=[select id,email from contact where email in:emailset];
        for(contact con:conlist){
            duplicate.add(con.Email);
        }
        
        for(contact con:newlist){
            if(con.email!=null && duplicate.contains(con.Email)){
                con.addError('Email Already Present in Object');
            }
        }
    }

  public static void populateEmail(list<contact> newlist){
        for(contact con:newlist){
            if(con.email == null){
                string email=con.lastname+'@gmail.com';
                con.Email=email.deletewhitespace();
            }
        }
    }

 public static void populatePhone(list<contact> newlist){
        set<id> accid=new set<id>();
        for(Contact con:newlist){
            if(con.AccountId!=null){
                accid.add(con.AccountId);
            }
        }
        
        map<id,account> accmap=new map<id,account>();
        list<Account> acclist=[select id,phone from account where phone!=null and id in:accid];
        for(Account acc:acclist){
            accmap.put(acc.id,acc);
        }
        for(Contact con:newlist){
            if(con.AccountId!=null){
                con.Phone=accmap.get(con.AccountId).phone;
            }
        }
    }

  public static void markConVip(list<contact> newlist){
        set<id> accid=new set<id>();
        for(Contact con:newlist){
            if(con.accountid!=null){
                accid.add(con.AccountId);
            }
        }
        
        list<Account> acclist=[select id,name,isVip__c from Account where isVip__c=TRUE and id in:accid];
        
        set<id>accids=new set<id>();
        for(Account acc:acclist){
            accids.add(acc.id);
        }
        
        for(Contact con:newlist){
            if(con.AccountId!=null){
                con.isConVip__c=accid.contains(con.AccountId);
            }
        }
    }

 public static void createAssoAccount(list<contact> newlist){
        list<account> acclist=new list<account>();
        for(Contact con:newlist){
            if(con.accountid==null){
                Account acc=new Account();
                acc.name=con.lastname;
                acclist.add(acc);
            }
        }
        if(acclist.size()>0){
            insert acclist;
        }
        
        map<String,id> newmap=new map<string,id>();
        for(Account acc:acclist){
            newmap.put(acc.name,acc.id);
        }
        
        for(Contact con:newlist){
            if(con.AccountId==null){
                con.AccountId=newmap.get(con.lastname);
            }
        }
    }


}
