public class AccountTriggerHandler {
//Add Billing to shipping
  public static void AddBillingToShipping(list<account> newlist){
        for(Account acc:newlist){
            if(acc.name!=null)
                acc.BillingCity=acc.ShippingCity;
                acc.BillingCountry=acc.ShippingCountry;
                acc.BillingState=acc.ShippingState;
                acc.BillingCountryCode=acc.ShippingCountryCode;
            }
        }
    }
//add error if revenue is less than 1000
   public static void checkRevenue(list<account> newlist){
        for(Account acc:newlist){
            if(acc.AnnualRevenue< 10000){
                acc.addError('Revenue should not be 10000');
            }
        }
    }

//prevent name updation 

  public static void checkNewName(list<account> newlist,map<id,Account> oldmap){
        for(Account acc:newlist){
            Account oldAcc=oldmap.get(acc.id);{
                if(acc.Name!=oldAcc.name){
                    acc.addError('U cant modify the Record');
                }
            }
        }  
    }


//when account insertion crate related contact 
  public static void createAssoContact(list<account> newlist){
        list<contact> conlist=new list<contact>();
        for(Account acc:newlist){
            if(acc.name!=null){
                Contact con=new Contact();
                con.lastname=acc.name+' Acc';
                con.AccountId=acc.id;
                conlist.add(con);
            }
        }
        if(conlist.size()>0){
            insert conlist;
        }
    }



  //whenever the account phone get updated also update its related contact phone
    public static void updateContactPhone(list<Account> newlist,map<id,account>oldmap){
        list<contact> conlist=new list<contact>();
        for(Account acc:newlist){
            Account oldAcc=oldmap.get(acc.id);
            if(acc.phone!=oldAcc.Phone){
                list<contact> conlist1=[select id,phone from contact where Accountid=:acc.id];
                for(Contact con:conlist1){
                    con.phone=acc.phone;
                    conlist.add(con);
                }
            }
        }
        if(conlist.size()>0){
            update conlist;
        }
    }

//delete contact 
  public static void deleteCon(list<Account> newlist){
        set<string> nameset=new set<string>();
        for(Account acc:newlist){
            nameset.add(acc.name);
        }
        
        list<contact> conlist=[select id,lastname from contact where lastname in:nameset];
        delete conlist;
    }

,//check duplicate account 
  public static void checkDuplicateAccount(list<account> newlist){
        set<string> nameset=new set<string>();
        for(Account acc:newlist){
            if(acc.Name!=null){
                nameset.add(acc.Name);
            }
        }
       
        set<string> duplicateName=new set<string>();
        for(Account acc:[select id,name from Account WHERE name in:nameset]){
            duplicateName.add(acc.Name);
        }
        
        for(Account acc:newlist){
            if(acc.Name!=null && duplicateName.contains(acc.Name)){
                acc.addError('Name Already Exists');
            }
        }
        
        
    }

//add prefix 

  public static void addMr(list<Account> newlist){
        for(Account acc:newlist){
            if(acc.Name!=null){
                acc.name='Mr'+' '+acc.Name;
            }
        }
    }

//prevent deletion 
   public static void preventDel(list<account> oldlist){
        for(Account acc:oldlist){
            if(acc.Rating=='Hot'){
                acc.addError('Account can not be deleted');
            }
        }
    }

//prevent account insertion if acc name is test
    public static void checkName(list<Account> newlist){
        for(Account acc:newlist){
            if(acc.name=='test'){
                acc.addError('Account name cannot be test');
            }
        }
    }

  //Account phone cannot be null
    public static void checkNulPhone(list<Account> newlist){
        for(Account acc:newlist){
            if(acc.Phone==Null){
                acc.addError('Account Phone Cannot be Null');
            }
        }
    }

//prevent Duplicate Account from getting Inserted
    public static void checkDuplicate(list<Account> newlist){
        set<string> nameset=new set<string>();
        set<string>duplicatenameset=new set<string>();
        for(Account acc:newlist){
            if(acc.Name!= null){
                nameset.add(acc.Name);
            }
        }
        for(Account acc:[select id,name from Account where Name in:nameset]){
            duplicatenameset.add(acc.Name);
        }
        
        for(Account acc:newlist){
            if(duplicatenameset.contains(acc.Name)){
                acc.addError('Name Already Exist');
            }
        }
    }

//Add billing Address to Shipping Address
    public static void AddBilingToShipping(list<Account> newlist){
        for(Account acc:newlist){
            if( acc.BillingStreet != null ||
                acc.BillingCity != null ||
                acc.BillingState != null ||
                acc.BillingPostalCode != null ||
                acc.BillingCountry != null){
                acc.ShippingCity=acc.BillingCity;
                acc.ShippingState=acc.BillingState;
                acc.ShippingCountry=acc.BillingCountry;
                acc.ShippingPostalCode=acc.BillingPostalCode;
                acc.ShippingStreet=acc.BillingStreet;
            }
        }
    }
}
