public class AccountTriggerHandler {

  public static void AddBillingToShipping(list<account> newlist){
        for(Account acc:newlist){
            if(acc.name!=null){
                
                acc.BillingCity=acc.ShippingCity;
                acc.BillingCountry=acc.ShippingCountry;
                acc.BillingState=acc.ShippingState;
                acc.BillingCountryCode=acc.ShippingCountryCode;
            }
        }
    }

   public static void checkRevenue(list<account> newlist){
        for(Account acc:newlist){
            if(acc.AnnualRevenue< 10000){
                acc.addError('Revenue should not be 10000');
            }
        }
    }

  public static void checkNewName(list<account> newlist,map<id,Account> oldmap){
        for(Account acc:newlist){
            Account oldAcc=oldmap.get(acc.id);{
                if(acc.Name!=oldAcc.name){
                    acc.addError('U cant modify the Record');
                }
            }
        }
        
    }
}
