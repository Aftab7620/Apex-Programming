    }
 }

    //upate acc with related opp
    public static void updateAcc(list<opportunity> opplist,map<id,opportunity> oldMap){
         set<id> accid=new set<id>();
        list<Account> acclist=new list<Account>();
        if(opplist.size()>0){
             for(Opportunity opp:opplist){
            if(opp.AccountId!=null){
                accid.add(opp.AccountId);
            }
             Opportunity oldOpp = oldMap.get(opp.ID);
            if(opp.AccountId!=oldOpp.AccountId){
                accId.add(oldOpp.AccountId);
            }
        }
            
        }
       
        for(AggregateResult ag:[select AccountId,count(Id) ct FROM Opportunity Where AccountId IN:accid GROUP BY AccountId]){
             Account acc=new Account();
            acc.id=(id)ag.get('AccountId');
            acc.Total_Opportunities__c=(double)ag.get('ct');
            acclist.add(acc);
            
            }
        
        if(acclist.size()>0){
            update acclist;
        }
           
        }

//update acc bakance 
   public static void updateBalanace(list<opportunity> newlist){
        set<Id> accid=new set<id>();
        list<Account> acclist=new list<Account>();
        for(Opportunity opp:newlist){
            if(opp.AccountId!=null){
                accid.add(opp.AccountId);
            }
        }
        
        for(AggregateResult ag:[select AccountId,Sum(Amount) total From Opportunity WHERE AccountId IN:accid GROUP BY AccountId]){
            Account acc=new Account();
            acc.id=(id)ag.get('AccountId');
            acc.Total_Amount__c	=(double)ag.get('total');
            acclist.add(acc);
            
        }
        
        if(acclist.size()>0){
            update acclist;
        }
    }

//update contact 
   public static void updateContact(list<opportunity> newlist){
        set<id> accid=new set<id>();
        for(Opportunity opp:newlist){
            if(opp.AccountId!=null && opp.StageName=='Closed Won'){
                accid.add(opp.AccountId);
            }
        }
        
        list<contact> conlist=[select Id,is_Valid__c,AccountId From Contact where AccountId IN:accid];
        for(Contact con:conlist){
            con.is_Valid__c=true;
        }
        
        if(conlist.size()>0){
            update conlist;
        }
    }public static void updateAccRecentAmtWithOpp(list<opportunity> newlist,map<id,Opportunity> oldmap){
        set<id> accid=new set<id>();
        map<id,decimal> amtMap=new map<id,decimal>();
        for(Opportunity opp:newlist){
            Opportunity oldAcc=oldMap.get(opp.id);
            if(opp.AccountId!=null && opp.StageName=='Closed Won'|| opp.Amount!=oldAcc.Amount){
                amtMap.put(opp.AccountId,opp.Amount);
            }
        }
        
        list<account> acclist=[select id,Recent_Opp_Amount__c from Account WHERE Id IN:amtmap.keyset()];
        for(Account acc:acclist){
            acc.Recent_Opp_Amount__c=amtmap.get(acc.id);
        }
        
        if(acclist.size()>0){
            update acclist;
        }
    }

//update account field
   public static void updateAcc(list<opportunity> newlist){
        set<id> accid=new set<id>();
        for(Opportunity opp:newlist){
            if(opp.AccountId!=null){
                accid.add(opp.AccountId);
            }
        }
        list<account> acclist2=new list<account>();
        list<Account> acclist=[SELECT id,(select id,stagename from opportunities where stagename='Closed Won') from account where Id IN:accid];
        for(Account acc:acclist){
                integer ct=acc.opportunities.size();
                if(ct>2){
                    acc.Rating='Hot';
                    acclist2.add(acc);
                }else{
                    acc.Rating='Warm';
                    acclist2.add(acc);
                }
            }
        
        if(acclist2.size()>0){
            update acclist2;
        }
        }
