    public static map<id,list<opportunity>> getAccRelOpp(){
        map<id,list<opportunity>> oppmap=new map<id,list<opportunity>>();
        list<Account> acclist=[SELECT ID,(SELECT Name,StageName FROM Opportunities Where AccountId != Null) From Account];
