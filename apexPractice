public class apexPractice{

   //1 Fetch all the contact which have @gmail.com in email and return the list of contacts
    public static list<contact> getAllConWithEmail(){
        list<contact> conlist=[SELECT Id,Email FROM CONTACT WHERE Email LIKE '%@gmail.com'];
        return conlist;
    }

    //2Create an Apex method that updates the Phone number of all Accounts in a specific industry to a defaultnumber.
    public static list<Account> updateAccount(){
        list<Account> updatedAcc=new list<Account>();
        list<Account> acclist=[SELECT Id,Name,Phone,Industry FROM Account Where Industry='Agriculture'];
        for(Account acc:acclist){
            acc.phone='12345678';
            updatedAcc.add(acc);
        }
        
        if(updatedAcc.size()>0){
            update updatedAcc;
        }
        return acclist;
    }


//Write an Apex method to delete all Opportunities with StageName = 'Closed Lost' older than one year.
 public static void deleteOpp(){
        Date yearAgo=Date.today().addYears(-1);
        list<opportunity> opplist=[SELECT ID,Name,StageName From Opportunity where StageName='Closed Lost' AND CloseDate <:yearAgo ];
        if(opplist.size()>0){
            delete opplist;
        }
    }


    //4Create an Apex method that takes a Set of Account Ids and returns a Map of Account Id to Account Name
    public static map<id,String> getAcc(set<id> accid){
        map<Id,String> accmap=new map<Id,String>();
        list<Account> acclist=[SELECT ID,Name FROM Account where Id IN: accid];
        for(Account acc:acclist){
            accmap.put(acc.id,acc.name);
        }
        return accmap;
        
    }

   public static map<Id,list<contact>> getAccWithContact(){
        map<Id,list<contact>> accmap=new map<Id,list<Contact>>();
        list<Account> acclist=[SELECT Id,Name,(SELECT ID,Name FROM Contacts) From Account];
        for(Account acc:acclist){
            accmap.put(acc.id,acc.contacts);
        }
        
        return accmap;
    }


   //7
    public static map<id,integer> getCountOfContact(){
        map<id,integer> accCount=new map<id,integer>();
        list<account> acclist=[SELECT Id,Name,(SELECT ID,Name FROM Contacts) From Account];
        for(Account acc:acclist){
            accCount.put(acc.id,acc.contacts.size());
        }
        return accCount;
        
    }


